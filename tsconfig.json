{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // Declaration emit must resolve packages through the node_modules symlinks
    // themselves: pnpm keeps them under node_modules/.pnpm, and resolving that
    // realpath makes TypeScript treat schemastery's Dict/Volatile types as
    // unnameable (TS2742 fails tsdown's dts step). npm's flat layout, which this
    // repository's package-lock.json pins, is unaffected by the flag.
    "preserveSymlinks": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "tsdown.config.ts", "vite.config.ts", "scripts", "test"]
}
